---
import { nav, site } from '../data/site';

const c = site.contact;
const social = [
	{ label: c.xHandle ? `X ${c.xHandle}` : 'X', href: c.x },
	{ label: 'YouTube', href: c.youtube },
	{ label: 'GitHub', href: c.github },
	{ label: 'Instagram', href: c.instagram },
].filter((s) => s.href);
---

<footer class="site-footer">
	<div class="wrap">
		<div class="cols">
			<div>
				<p style="font-weight:700;font-size:16px;margin-bottom:4px">{site.name}</p>
				<p style="color:var(--muted);margin:0 0 16px">{site.english}</p>
				<address style="font-style:normal;color:var(--muted)">
					〒{site.address.postal}
					<br />
					{site.address.lines.map((l, i) => (
						<>
							{i > 0 && <br />}
							{l}
						</>
					))}
				</address>
			</div>
			<div>
				<h2>Menu</h2>
				<ul>
					<li>
						<a href="/">TOP</a>
					</li>
					{nav.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))}
				</ul>
			</div>
			<div>
				<h2>Contact</h2>
				<ul>
					{c.email && (
						<li>
							<a href={`mailto:${c.email}`}>{c.email}</a>
						</li>
					)}
					{social.map((s) => (
						<li>
							<a href={s.href} rel="noopener noreferrer" target="_blank">
								{s.label}
							</a>
						</li>
					))}
					{!c.email && social.length === 0 && <li style="color:var(--muted)">連絡先は準備中です</li>}
				</ul>
			</div>
		</div>
		<p class="copy">
			© {new Date().getFullYear()} {site.name}
		</p>
	</div>
</footer>
