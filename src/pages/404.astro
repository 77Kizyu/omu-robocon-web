---
import Base from '../layouts/Base.astro';
---

<Base title="ページが見つかりません">
	<div class="page-body" style="padding-block:96px">
		<div class="wrap">
			<p class="eyebrow">404</p>
			<h1 style="font-size:clamp(28px,5vw,44px);margin-bottom:16px">ページが見つかりません</h1>
			<p style="color:var(--muted)">URL が間違っているか、ページが移動した可能性があります。</p>
			<a class="btn primary" href="/">
				トップへ戻る
			</a>
		</div>
	</div>
</Base>
