---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const posts = await getCollection('news', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, category, summary } = post.data;
const ymd = date.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Tokyo' }).replaceAll('/', '.');
---

<Base title={title} description={summary} type="article">
	<div class="page-head">
		<div class="wrap">
			<div class="meta" style="margin-bottom:14px">
				<time datetime={date.toISOString()}>{ymd}</time>
				<span class="tag">{category}</span>
			</div>
			<h1>{title}</h1>
		</div>
	</div>
	<div class="page-body">
		<div class="wrap">
			<article class="prose">
				<Content />
			</article>
			<p style="margin-top:56px"><a href="/news">← 活動記事一覧へ</a></p>
		</div>
	</div>
</Base>
