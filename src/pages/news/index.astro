---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="活動記事" description="大阪公立大学ロボットコンテストクラブの活動報告・大会結果・お知らせ。">
	<div class="page-head">
		<div class="wrap">
			<p class="eyebrow">News</p>
			<h1>活動記事</h1>
			<p>活動報告、大会の記録、お知らせをまとめています。</p>
		</div>
	</div>
	<div class="page-body">
		<div class="wrap">
			{posts.length > 0 ? (
				<div class="grid cols-3">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<div class="empty">記事はまだありません。</div>
			)}
		</div>
	</div>
</Base>
